{
  "name": "mailforge",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de correo electrónico propio - Arquitectura híbrida Vercel + VPS",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web"
  },
  "keywords": [
    "email",
    "smtp",
    "imap",
    "postfix",
    "dovecot",
    "nextjs",
    "vercel"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
