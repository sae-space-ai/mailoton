# ============================================
# MAILFORGE - Variables de Entorno
# ============================================
# COPIAR A .env Y RELENAR CON VALORES REALES
# NUNCA commitear .env al repositorio
# ============================================

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
DOMAIN=midominio.com

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mailforge
DB_USER=mailforge
DB_PASSWORD=cambiar_por_password_seguro_32_chars

# ============================================
# AUTHENTICATION
# ============================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generar_con_openssl_rand_hex_32

# ============================================
# MAIL (Fase 4+)
# ============================================
# SMTP_HOST=mail.midominio.com
# SMTP_PORT=587
# SMTP_USER=admin@midominio.com
# SMTP_PASSWORD=cambiar_por_password_seguro

# IMAP_HOST=mail.midominio.com
# IMAP_PORT=993

# ============================================
# INFRASTRUCTURE (Fase 3+)
# ============================================
# VPS_IP=203.0.113.10
# VPS_HOST=mail.midominio.com
# VPS_SSH_PORT=2222

# ACME_EMAIL=admin@midominio.com

# ============================================
# VERCEL
# ============================================
